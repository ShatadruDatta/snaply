{
  "expo": {
    "name": "SNAPLY",
    "slug": "SNAPLY",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snaply",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.SNAPLY"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f2fc",
          "image": "./assets/images/snaply-launch-mark.png",
          "imageWidth": 128,
          "ios": {
            "image": "./assets/images/snaply-splash.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover"
          }
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your Snaply posts, profile, or messages.",
          "microphonePermission": "Record voice messages to send in Snaply chats.",
          "cameraPermission": "Use the camera to take a photo for your Snaply post."
        }
      ],
      "expo-video",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice messages to send in Snaply chats.",
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e811be50-7f35-473c-b85f-1b51ca247ba5"
      }
    },
    "owner": "shatadru_datta01"
  }
}
